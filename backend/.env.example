# Perch backend configuration. Copy to .env and fill in real values.

# Server
PORT=3001
# Graceful shutdown drain window. After SIGTERM the server stops accepting
# new connections and waits up to this many milliseconds before force-exiting.
DRAIN_DEADLINE_MS=10000
# Development-only compatibility bridge. Production leaves this unset; native
# clients connect outbound to DEVICE_GATEWAY_URL.
NOTCH_WS_URL=ws://localhost:7778/ws
# Required for production OAuth callbacks; must be an HTTPS origin.
PUBLIC_BASE_URL=
DEVICE_GATEWAY_URL=
DEVICE_TICKET_SIGNING_SECRET=
TRUST_PROXY=1
DEVICE_ALLOWED_ORIGINS=perch://app
JSON_BODY_LIMIT_BYTES=65536
DEVICE_FRESH_AUTH_MAX_AGE_MS=300000
DEVICE_CHALLENGE_TTL_MS=60000
DEVICE_TICKET_TTL_MS=30000
DEVICE_MAX_PER_USER=3
DEVICE_MAX_PAYLOAD_BYTES=65536
DEVICE_MAX_MESSAGES_PER_WINDOW=120
DEVICE_MAX_BYTES_PER_WINDOW=524288
DEVICE_RATE_WINDOW_MS=60000
DEVICE_MAX_CONNECTION_BYTES=16777216
DEVICE_MAX_BUFFERED_BYTES=262144
DEVICE_HEARTBEAT_INTERVAL_MS=20000
DEVICE_HEARTBEAT_TIMEOUT_MS=60000
DEVICE_HANDSHAKE_TIMEOUT_MS=5000
DEVICE_REPLAY_PAGE_SIZE=100
DEVICE_WAITING_EXPIRY_SWEEP_MS=30000
OAUTH_STATE_TTL_MS=600000
# Browser-hosted anti-abuse challenge. Supported providers: turnstile, hcaptcha.
CAPTCHA_PROVIDER=turnstile
CAPTCHA_SITE_KEY=
CAPTCHA_SECRET=
CAPTCHA_EXPECTED_HOSTNAME=
# Comma-separated disposable or administratively blocked email domains.
SIGNUP_BLOCKED_DOMAINS=
# Enable only after migration 011 and all operation-specific quota credentials
# are deployed. Production has no process-memory quota fallback.
PUBLIC_SIGNUP_ENABLED=false
COSTLY_INTEGRATIONS_ENABLED=false

# LLM fallback (server key used during active trials only)
TRIALS_ENABLED=false
TRIAL_ANTHROPIC_API_KEY=
TRIAL_ANTHROPIC_MODELS=claude-sonnet-4-6
TRIAL_ANTHROPIC_MODEL=claude-sonnet-4-6
TRIAL_MAX_CONCURRENCY=2
TRIAL_DAILY_TOKEN_LIMIT=50000
TRIAL_DAILY_SPEND_MICRO_USD=250000
MAX_TOKENS=4096
SCHEDULER_MAX_TASKS_PER_USER=5
SCHEDULER_MIN_INTERVAL_MS=900000
SCHEDULER_MAX_TOKENS=1024
SCHEDULER_CLAIM_LIMIT=10
AUTH_RATE_WINDOW_MS=900000
AUTH_LOGIN_RATE_LIMIT=10
AUTH_REFRESH_RATE_LIMIT=30

# Supabase
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Development compatibility only; production uses the operation-specific
# secrets below. Each key must map to its matching least-privilege DB role.
SUPABASE_ANON_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_BOOTSTRAP_SECRET_KEY=
SUPABASE_WEBHOOK_SECRET_KEY=
SUPABASE_SCHEDULER_SECRET_KEY=
SUPABASE_FENCING_SECRET_KEY=
SUPABASE_RECONCILIATION_SECRET_KEY=
SUPABASE_PROVIDER_SECRET_KEY=
SUPABASE_RUNNER_SECRET_KEY=
SUPABASE_JWT_SECRET=
# Postgres connection string for migrations (postgresql://...). Required by npm run db:migrate.
SUPABASE_DB_URL=
# Optional private CA for remote Postgres. TLS verification is always enabled.
DATABASE_SSL_CA_FILE=

# BYOK provider key encryption. REQUIRED — the server refuses to start
# provider encryption/decryption without it. Generate a long random string.
PROVIDER_KEY_SECRET=

# Composio integrations
COMPOSIO_API_KEY=
# Pinned dashboard auth configurations with reviewed minimum scopes. Runtime
# discovery is not used in production.
COMPOSIO_AUTH_CONFIG_GMAIL=
COMPOSIO_AUTH_CONFIG_GOOGLECALENDAR=
COMPOSIO_AUTH_CONFIG_GOOGLEDOCS=
COMPOSIO_AUTH_CONFIG_GITHUB=

# Dodo Payments (one-time purchase unlock). Production startup requires all
# values below, live_mode, and an HTTPS return URL at /api/billing/return.
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_WEBHOOK_KEY=
DODO_PAYMENTS_PRODUCT_ID=
DODO_PAYMENTS_RETURN_URL=
DODO_PAYMENTS_ENVIRONMENT=test_mode
# Strict commercial contract. A verified payment must match these exactly (plus
# the product id) before it grants an entitlement. Amount is in minor units.
DODO_PAYMENTS_EXPECTED_AMOUNT=500
DODO_PAYMENTS_EXPECTED_CURRENCY=USD
DODO_PAYMENTS_EXPECTED_QUANTITY=1

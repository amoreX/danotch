# Optional non-secret tuning for the local per-user daemon.
# Provider and Composio secrets are never read from this file or the environment.
# The bundled native host supplies the installation secret and allowlisted
# Keychain operations over a private process channel. File-descriptor/stdin
# fallbacks exist only for isolated development and tests.

PERCH_DATA_DIR=
PERCH_ALLOWED_ORIGIN=perch://app
JSON_BODY_LIMIT_BYTES=65536
MAX_TOKENS=4096
SESSION_TTL_MS=300000
HTTP_RATE_WINDOW_MS=60000
HTTP_RATE_LIMIT=240
WS_MAX_FRAME_BYTES=65536
WS_MAX_MESSAGES_PER_WINDOW=120
SCHEDULER_TICK_MS=30000
SCHEDULER_CLAIM_LIMIT=10
SCHEDULER_MAX_CATCH_UP=3
SCHEDULER_MIN_INTERVAL_MS=60000
SCHEDULER_MAX_TOKENS=2048
DRAIN_DEADLINE_MS=10000

{
  "name": "perch-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "db:migrate": "node scripts/migrate.mjs",
    "db:verify": "node scripts/migrate.mjs --verify",
    "db:baseline": "node scripts/migrate.mjs --baseline",
    "db:fingerprint": "node scripts/migrate.mjs --fingerprint",
    "db:snapshot": "node scripts/generate-schema-snapshot.mjs",
    "test:db": "node --import tsx --test src/db/*.integration.test.ts src/db/*.test.ts src/agent/runner.integration.test.ts src/protocol/*.integration.test.ts",
    "db:billing": "node scripts/migrate.mjs",
    "test": "node --import tsx --test src/*.test.ts src/**/*.test.ts",
    "test:runtime-policy": "node --permission --allow-fs-read=. scripts/verify-process-permission.mjs",
    "start": "node --permission --allow-fs-read=. dist/index.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "@composio/anthropic": "^0.10.1",
    "@composio/core": "^0.14.0",
    "@supabase/supabase-js": "^2.101.1",
    "@types/jsonwebtoken": "^9.0.10",
    "cron-parser": "^5.5.0",
    "dodopayments": "^2.40.1",
    "dotenv": "^17.4.0",
    "express": "^4.21.0",
    "express-rate-limit": "^8.6.0",
    "jsonwebtoken": "^9.0.3",
    "openai": "^6.34.0",
    "pg": "^8.22.0",
    "uuid": "^11.1.0",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/pg": "^8.20.0",
    "@types/uuid": "^10.0.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0"
  }
}

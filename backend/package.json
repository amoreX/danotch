{
  "name": "perch-backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "db:verify": "node --import tsx src/db/verify.ts",
    "test:db": "node --import tsx --test src/db/*.test.ts",
    "test": "node --import tsx --test src/*.test.ts src/**/*.test.ts",
    "test:runtime-policy": "node --permission --allow-fs-read=. scripts/verify-process-permission.mjs",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.110.0",
    "@composio/core": "^0.14.0",
    "cron-parser": "^5.5.0",
    "express": "^4.21.0",
    "express-rate-limit": "^8.6.0",
    "openai": "^6.34.0",
    "ws": "^8.21.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^24.0.0",
    "@types/ws": "^8.5.13",
    "tsx": "^4.23.1",
    "typescript": "^5.7.0"
  }
}

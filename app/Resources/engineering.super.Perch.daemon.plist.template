<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>engineering.super.Perch.daemon</string>
	<key>ProgramArguments</key>
	<array>
		<string>__PERCH_APP_PATH__/Contents/Helpers/PerchDaemonHost</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<dict>
		<key>SuccessfulExit</key>
		<false/>
	</dict>
	<key>ProcessType</key>
	<string>Background</string>
	<key>StandardOutPath</key>
	<string>/dev/null</string>
	<key>StandardErrorPath</key>
	<string>__PERCH_LOG_PATH__/daemon.log</string>
	<key>ThrottleInterval</key>
	<integer>10</integer>
</dict>
</plist>
